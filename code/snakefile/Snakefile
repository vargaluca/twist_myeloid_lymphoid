## complete Snakemake script for myeloid-lymphoid twist panel analysis

import glob
import os
import gzip

#getting specific wildcards for the run
wildcard_constraints:
	run  = r"[^/]+",
	name  = r"[^/.]+"

RUN = config.get("run", "run1")
NAMES = glob_wildcards(f"raw_reads/{RUN}/{{name}}_L001_R1_001.fastq.gz").name
WORKDIR = os.getcwd()
SNAKEDIR = workflow.basedir

#ignoring samples starting with:
IGNORE_PREFIX = ("Undetermined", "Kontroll", "Control", "control", "kontroll")

NAMES   = [n for n in NAMES   if not n.startswith(IGNORE_PREFIX)]
#SAMPLES = [s for s in SAMPLES if not s.startswith(IGNORE_PREFIX)]

#endpoint files
rule all:
	input:
		expand("tables/{run}/raw_multiqc.html", run=RUN),
		expand("tables/{run}/trimmed_multiqc.html", run=RUN),
		expand("tables/{run}/{name}.xlsx", name=NAMES, run=RUN),
		expand("tables/{run}/{run}-combined_table.xlsx", run=RUN),
		expand("tables/{run}/bam_multiqc.html", run=RUN)

## pipeline rules

#to show whole process in the DAG
rule raw_reads:
	output: 
		expand("raw_reads/{run}/{name}_L001_R1_001.fastq.gz", name=NAMES, run=RUN),
                expand("raw_reads/{run}/{name}_L001_R2_001.fastq.gz", name=NAMES, run=RUN)
	shell:
		"false"

#actual rules
rule raw_fastqc:
	output:
		html1 = temp("raw_fastqc/{run}/{name}_L001_R1_001_fastqc.html"),
		zip1 = temp("raw_fastqc/{run}/{name}_L001_R1_001_fastqc.zip"),
		html2 = temp("raw_fastqc/{run}/{name}_L001_R2_001_fastqc.html"),
		zip2 = temp("raw_fastqc/{run}/{name}_L001_R2_001_fastqc.zip")
	input: 
		R1 = "raw_reads/{run}/{name}_L001_R1_001.fastq.gz",
		R2 = "raw_reads/{run}/{name}_L001_R2_001.fastq.gz"
	log:
		SNAKEDIR + "/logs/{run}/{name}.log"
	shell:
		"""
		/disk/work/shared/tools/FastQC/fastqc -o raw_fastqc/{wildcards.run}/ {input} >> {log} 2>&1
		"""

rule raw_multiqc:
	output:
		html = "tables/{run}/raw_multiqc.html",
		folder = temp(directory("raw_fastqc/{run}/raw_multiqc_data"))
	input:
		expand("raw_fastqc/{run}/{name}_L001_R1_001_fastqc.html", name=NAMES, run=RUN),
		expand("raw_fastqc/{run}/{name}_L001_R2_001_fastqc.html", name=NAMES, run=RUN),
		expand("raw_fastqc/{run}/{name}_L001_R1_001_fastqc.zip", name=NAMES, run=RUN),
		expand("raw_fastqc/{run}/{name}_L001_R2_001_fastqc.zip", name=NAMES, run=RUN)
	shell:
		"""
		multiqc -f raw_fastqc/{wildcards.run}/ --filename raw_fastqc/{wildcards.run}/raw_multiqc.html
		mv raw_fastqc/{wildcards.run}/raw_multiqc.html tables/{wildcards.run}/
		"""

rule trim_reads:
	output:
		R1 = temp("trimmed_reads/{run}/{name}.trimmed_R1.fastq.gz"),
		R2 = temp("trimmed_reads/{run}/{name}.trimmed_R2.fastq.gz"),
		mbc = temp("trimmed_reads/{run}/{name}.trimmed_MBC.txt.gz"),
		stats = temp("trimmed_reads/{run}/{name}.trimmed_STATS.properties")
	input:
		R1 = "raw_reads/{run}/{name}_L001_R1_001.fastq.gz",
		R2 = "raw_reads/{run}/{name}_L001_R2_001.fastq.gz"
	log:
		SNAKEDIR + "/logs/{run}/{name}.log"
	shell:
		"""
		module load agent
		agent trim -v2 -out trimmed_reads/{wildcards.run}/{wildcards.name}.trimmed -fq1 {input.R1} -fq2 {input.R2} >> {log} 2>&1
		"""	

rule trimmed_fastqc:
	output:
		html1 = temp("trimmed_fastqc/{run}/{name}.trimmed_R1_fastqc.html"),
		zip1 = temp("trimmed_fastqc/{run}/{name}.trimmed_R1_fastqc.zip"),
		html2 = temp("trimmed_fastqc/{run}/{name}.trimmed_R2_fastqc.html"),
		zip2 = temp("trimmed_fastqc/{run}/{name}.trimmed_R2_fastqc.zip")
	input:
		R1 = "trimmed_reads/{run}/{name}.trimmed_R1.fastq.gz",
		R2 = "trimmed_reads/{run}/{name}.trimmed_R2.fastq.gz"
	params:
		fastqc = config["fastqc"]
	log:
		SNAKEDIR + "/logs/{run}/{name}.log"
	shell:
                """
                {params.fastqc} -o trimmed_fastqc/{wildcards.run}/ {input} >> {log} 2>&1
                """

rule trimmed_multiqc:
        output:
                "tables/{run}/trimmed_multiqc.html",
		folder = temp(directory("trimmed_fastqc/{run}/trimmed_multiqc_data"))
        input:
                expand("trimmed_fastqc/{run}/{name}.trimmed_R1_fastqc.html", name=NAMES, run=RUN),
		expand("trimmed_fastqc/{run}/{name}.trimmed_R1_fastqc.zip", name=NAMES, run=RUN),
		expand("trimmed_fastqc/{run}/{name}.trimmed_R2_fastqc.html", name=NAMES, run=RUN),
		expand("trimmed_fastqc/{run}/{name}.trimmed_R2_fastqc.zip", name=NAMES, run=RUN)
	shell:
                """
                multiqc -f trimmed_fastqc/{wildcards.run} --filename trimmed_fastqc/{wildcards.run}/trimmed_multiqc.html
		mv trimmed_fastqc/{wildcards.run}/trimmed_multiqc.html tables/{wildcards.run}/
                """

#function for defining read group info for each sample (called in rule align_reads params)
def read_group(wildcards, input):
    with gzip.open(input.R1, "rt") as f:
        header = f.readline().strip()          # @instrument:run:flowcell:lane:tile:x:y
    fields = header.lstrip("@").split(" ")[0].split(":")  # same as cut -f 3-4 (flowcell.lane) and cut -f 1,3,4 (instrument.flowcell.lane)
    rg_id = f"{fields[2]}.{fields[3]}"
    pu    = f"{fields[0]}.{fields[2]}.{fields[3]}"
    name = wildcards.name
    return rf"@RG\tID:{rg_id}\tPL:illumina\tPU:{pu}\tSM:{name}\tLB:{name}"

rule align_reads:
	output:
                temp("aligned_reads/{run}/{name}_aligned.bam")
	input:
		R1  = "trimmed_reads/{run}/{name}.trimmed_R1.fastq.gz",
		R2  = "trimmed_reads/{run}/{name}.trimmed_R2.fastq.gz"
	params:
		rg = read_group,
		reference = config["reffasta_gz"],
		bwa = config["bwa"],
		samtools = config["samtools"]
	log:
		SNAKEDIR + "/logs/{run}/{name}.log"
	shell:
		"""
		{params.bwa} mem -R '{params.rg}' -C -t 4 \
		{params.reference} {input.R1} {input.R2} 2>> {log} | \
		{params.samtools} view -b > {output} 2>> {log}
		echo "exit codes (bwa, samtools): ${{PIPESTATUS[@]}}" >> {log}
		set -e
		"""

rule sort_aligned:
	output:
		temp("aligned_reads/{run}/{name}_sorted.bam")
	input:
		"aligned_reads/{run}/{name}_aligned.bam"
	params:
		samtools = config["samtools"]
	log:
		SNAKEDIR + "/logs/{run}/{name}.log"
	shell:
		"""
		{params.samtools} sort {input} -o {output} >> {log} 2>&1
		"""

rule mark_duplicates:
	output:
		bam = temp("dedup_aligned_reads/{run}/{name}.duplicate_marked.bam"),
		bai = temp("dedup_aligned_reads/{run}/{name}.duplicate_marked.bai"),
		metrics = temp("dedup_aligned_reads/{run}/{name}.duplicate_marked.metrics")
	input:
		"aligned_reads/{run}/{name}_sorted.bam"
	params:
		gatk = config["gatk"]
	log:
		SNAKEDIR + "/logs/{run}/{name}.log"
	shell:
		"""
		{params.gatk} --java-options "-Xmx12G" MarkDuplicates \
		--INPUT {input} \
		--OUTPUT {output.bam} \
		--METRICS_FILE {output.metrics} \
		--CREATE_INDEX true --ASSUME_SORTED true --TMP_DIR tmp --OPTICAL_DUPLICATE_PIXEL_DISTANCE 2500 >> {log} 2>&1
		"""

rule deduplicated_bamqc:
	output:
		temp(directory("bam_qc/{run}/{name}"))
	input:
		"dedup_aligned_reads/{run}/{name}.duplicate_marked.bam"
	params:
		report = "bam_qc/{run}/{name}/{name}.qualimapReport.html",
		bed = config["bed"],
		qualimap = config["qualimap"]
	log:
		SNAKEDIR + "/logs/{run}/{name}.log"
	shell:
		"""
		{params.qualimap} bamqc -bam {input} -outdir {output} \
		-gff {params.bed} --java-mem-size=4G >> {log} 2>&1

		mv {output}/qualimapReport.html {params.report}
		"""

rule bamqc_paths:
    input:
        lambda wc: expand("bam_qc/{run}/{name}", run=wc.run, name=NAMES)
    output:
        temp("bam_qc/{run}/file_paths.txt")
    run:
        with open(output[0], "w") as f:
            for p in input:
                f.write(os.path.dirname(p) + "\n")

rule bam_multiqc:
	output:
		"tables/{run}/bam_multiqc.html",
		folder = temp(directory("bam_qc/{run}/bam_multiqc_data"))
	input:
		bams = expand("bam_qc/{run}/{name}", run=RUN, name=NAMES),
		paths = "bam_qc/{run}/file_paths.txt"
	shell:
		"""
		multiqc -n bam_qc/{wildcards.run}/bam_multiqc.html \
		--file-list {input.paths}

		mv bam_qc/{wildcards.run}/bam_multiqc.html "tables/{wildcards.run}/bam_multiqc.html"
                """

rule recalibrate_table:
	output:
		temp("recal_aligned_reads/{run}/{name}.recal_data.table")
	input:
		"dedup_aligned_reads/{run}/{name}.duplicate_marked.bam"
	params:
		reference = config["reffasta"],
		known1 = config["gatk_1000G"],
		known2 = config["gatk_mills"],
		known3 = config["gatk_dbsnp"],
		gatk = config["gatk"]
	log:
		SNAKEDIR + "/logs/{run}/{name}.log"
	shell:
		"""
		{params.gatk} BaseRecalibrator -I {input} -R {params.reference} \
		-O {output} --known-sites {params.known1} \
		--known-sites {params.known2} \
		--known-sites {params.known3} >> {log} 2>&1
		"""

rule apply_recalibration:
	output: 
		"recal_aligned_reads/{run}/{name}.recalibrated.bam"
	input:
		table = "recal_aligned_reads/{run}/{name}.recal_data.table",
		bam = "dedup_aligned_reads/{run}/{name}.duplicate_marked.bam"
	params:
		reference = config["reffasta"],
		gatk = config["gatk"]
	log:
		SNAKEDIR + "/logs/{run}/{name}.log"
	shell:
		"""
		{params.gatk} --java-options "-Xmx12G" ApplyBQSR \
		-R {params.reference} \
		-I {input.bam} \
		--bqsr-recal-file {input.table} -O {output} --tmp-dir tmp >> {log} 2>&1
		"""

rule variant_calling:
	output:
		f1r2 = temp("variant_calls/{run}/f1r2/{name}-f1r2.tar.gz"),
		vcf = temp("variant_calls/{run}/unfiltered_vcf/{name}.unfiltered.vcf.gz"),
		stats = temp("variant_calls/{run}/unfiltered_vcf/{name}.unfiltered.vcf.gz.stats"),
		tbi = temp("variant_calls/{run}/unfiltered_vcf/{name}.unfiltered.vcf.gz.tbi")
	input:
		"recal_aligned_reads/{run}/{name}.recalibrated.bam"
	params:
		reference = config["reffasta"],
		bed = config["bed"],
		germline = config["gnomad"],
		pon = config["mutect2_exomes"],
		gatk = config["gatk"]
	log:
		SNAKEDIR + "/logs/{run}/{name}.log"
	shell:
		"""
		{params.gatk} Mutect2 -R {params.reference} -I {input} \
		--germline-resource {params.germline} \
		--panel-of-normals {params.pon} \
		--f1r2-tar-gz {output.f1r2} \
		-L {params.bed} \
		-O {output.vcf} >> {log} 2>&1
		"""

rule read_orientation:
	output:
		temp("variant_calls/{run}/read_orientation_model/{name}-read-orientation-model.tar.gz")
	input:
		"variant_calls/{run}/f1r2/{name}-f1r2.tar.gz"
	params:
		gatk = config["gatk"]
	log:
		SNAKEDIR + "/logs/{run}/{name}.log"
	shell:
		"""
		{params.gatk} LearnReadOrientationModel -I {input} -O {output} >> {log} 2>&1
		"""

rule pileup_summaries:
	output:
		temp("variant_calls/{run}/pileup_summaries/{name}-pileupsummaries.table")
	input:
		"recal_aligned_reads/{run}/{name}.recalibrated.bam"
	params:
		somatic = config["gatk_small_exac"],
		gatk = config["gatk"]
	log:
		SNAKEDIR + "/logs/{run}/{name}.log"
	shell:
		"""
		{params.gatk} GetPileupSummaries -I {input} \
		-V {params.somatic} \
		-L {params.somatic} \
		-O {output} >> {log} 2>&1
		"""

rule contamination_table:
	output:
		temp("variant_calls/{run}/contamination/{name}-contamination.table")
	input:
		pileup = "variant_calls/{run}/pileup_summaries/{name}-pileupsummaries.table"
	params:
		gatk = config["gatk"]
	log:
		SNAKEDIR + "/logs/{run}/{name}.log"
	shell:
		"""
		{params.gatk} CalculateContamination -I {input} -O {output} >> {log} 2>&1
		"""

rule filtered_variants:
	output: 
		vcf = temp("variant_calls/{run}/filtered_vcf/{name}.filtered.vcf.gz"),
		stats = temp("variant_calls/{run}/filtered_vcf/{name}.filtered.vcf.gz.filteringStats.tsv"),
		tbi = temp("variant_calls/{run}/filtered_vcf/{name}.filtered.vcf.gz.tbi")
	input:
		vcf = "variant_calls/{run}/unfiltered_vcf/{name}.unfiltered.vcf.gz",
		contamination = "variant_calls/{run}/contamination/{name}-contamination.table",
		readorientation = "variant_calls/{run}/read_orientation_model/{name}-read-orientation-model.tar.gz",
		tbi = "variant_calls/{run}/unfiltered_vcf/{name}.unfiltered.vcf.gz.tbi"
	params:
		reference = config["reffasta"],
		gatk = config["gatk"]
	log:
		SNAKEDIR + "/logs/{run}/{name}.log"
	shell:
		"""
		{params.gatk} FilterMutectCalls -R {params.reference} \
		-V {input.vcf} --contamination-table {input.contamination} --ob-priors {input.readorientation} \
		-O {output.vcf} >> {log} 2>&1
		"""

rule annotation:
	output:
		"annotation/{run}/{name}.annotated.vcf"
	input:
		vcf = "variant_calls/{run}/filtered_vcf/{name}.filtered.vcf.gz",
		tbi = "variant_calls/{run}/filtered_vcf/{name}.filtered.vcf.gz.tbi"
	params:
		reference = config["reffasta"],
		gnomad = config["gnomad_gz"],
		vep_cache = config["vep_cache"],
		vep = config["vep"]
	log:
		SNAKEDIR + "/logs/{run}/{name}.log"
	shell:
		"""
		{params.vep} --dir_cache {params.vep_cache} --cache \
		--fasta {params.reference} --offline -i {input.vcf} \
                --vcf --pick --force_overwrite --assembly GRCh37 --fork 8 \
                --failed 1 --sift b \
                --polyphen b --ccds --hgvs --symbol --numbers --domains --regulatory \
                --canonical --protein --biotype --af --af_1kg --max_af --pubmed \
                --uniprot --variant_class --gene_phenotype \
                --custom file={params.gnomad},short_name=gnomadAF,format=vcf,type=exact,fields=AC%AF \
                -o {output} >> {log} 2>&1
		"""

rule annotated_to_maf:
	output:
		temp("maf_files/{run}/{name}.annotated.maf.gz")
	input:
		"annotation/{run}/{name}.annotated.vcf"
	params:
		reference = config["reffasta"],
		vcf2maf = config["vcf2maf"]
	log:
		SNAKEDIR + "/logs/{run}/{name}.log"
	shell:
		"""
		module load samtools
		module load vcf2maf
		module load tabix

		perl {params.vcf2maf} --input-vcf {input} --output-maf {output} \
		--retain-fmt --retain-info --retain-ann gnomadAF_AC,gnomadAF_AF \
		--tumor-id {wildcards.name} --vcf-tumor-id {wildcards.name} --inhibit-vep \
		--ref-fasta {params.reference} >> {log} 2>&1

		gzip {output}
		"""

rule maf_to_xlsx:
	output:
		"tables/{run}/{name}.xlsx"
	input:
		"maf_files/{run}/{name}.annotated.maf.gz"
	params:
		Rscript = config["Rscript"],
		script = SNAKEDIR + "/R/table_to_xlsx.R"
	log:
		SNAKEDIR + "/logs/{run}/{name}.log"
	shell:
		"""
		{params.Rscript} \
		{params.script} \
		{WORKDIR}/{input} {WORKDIR}/{output} >> {log} 2>&1
		"""

rule all_samples_xlsx:
	output:
		"tables/{run}/{run}-combined_table.xlsx"
	input:
		expand("maf_files/{run}/{name}.annotated.maf.gz", name=NAMES, run=RUN)
	params:
		Rscript = config["Rscript"],
		script = SNAKEDIR + "/R/combined_table.R"
	shell:
		"""
		{params.Rscript} \
		{params.script} \
		{WORKDIR}/maf_files/{wildcards.run} {WORKDIR}/{output}
		"""
